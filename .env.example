NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # serveur uniquement, jamais exposée
RESEND_API_KEY=                      # compte Resend créé depuis contact@insenstudio.com
NOTIFICATION_EMAIL=contact@insenstudio.com   # boîte destinataire des leads
MAIL_FROM=INSEN Studio <contact@insenstudio.com>   # expéditeur (domaine insenstudio.com vérifié dans Resend)
CALCOM_WEBHOOK_SECRET=
NEXT_PUBLIC_CALCOM_LINK=             # ex: insen/consultation
NEXT_PUBLIC_SITE_URL=https://go.insenstudio.com
NEXT_PUBLIC_HOME_URL=https://insenstudio.com
# Origines autorisées à POSTer sur /api/leads (la vitrine, cross-origin).
# Séparées par des virgules.
ALLOWED_ORIGINS=https://insenstudio.com,https://www.insenstudio.com

# --- Couche anti-abus (src/lib/security) ---
# NB : ALLOWED_ORIGINS ci-dessus sert aussi de garde d'origine côté serveur.
# L'origine de l'app (go.insenstudio.com) y est toujours ajoutée d'office.
# ÉTAPE 2 — à passer à 1 SEULEMENT une fois le formulaire de contact de la
# vitrine ré-injecté dans Squarespace (il doit envoyer form_rendered_at).
# Activer avant = perte de vrais leads.
ANTIBOT_STRICT=0
# Interrupteur d'exploitation : 1 neutralise toute la couche sans redéployer.
ANTIBOT_DISABLED=0
